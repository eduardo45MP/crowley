# Etsy Open API v3 credentials. Both values are required for --provider etsy.
ETSY_API_KEY=
ETSY_API_SECRET=

# Canonical products and immutable raw observations.
DATABASE_URL=sqlite:///./data/products.db

# Optional crawler tuning.
CRAWLER_REQUESTS_PER_SECOND=2
CRAWLER_DELAY_BETWEEN_REQUESTS=0.5
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT=15
